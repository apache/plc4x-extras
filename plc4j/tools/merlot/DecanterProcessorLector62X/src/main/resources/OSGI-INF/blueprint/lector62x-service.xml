<blueprint xmlns="http://www.osgi.org/xmlns/blueprint/v1.0.0"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="
             http://www.osgi.org/xmlns/blueprint/v1.0.0 https://www.osgi.org/xmlns/blueprint/v1.0.0/blueprint.xsd"
           default-activation="eager">
    
  
    <!--Processor Decanter Bean-->
    <bean
        id="MerlotProcessorDataLector62xBean"
        class="org.apache.plc4x.merlot.lector62x.impl.MerlotDecanterProcessorDataLector62XImpl"
        init-method="init"  
        destroy-method="destroy"
        scope="singleton"
        activation="eager">
        <argument ref="blueprintBundleContext"/>
    </bean> 
    
    <!--Repository Bean--> 
    <bean
        id="MerlotLecto620ShippingPackageRepositoryBean"
        class="org.apache.plc4x.merlot.lector62x.impl.MerlotLecto620ShippingPackageRepositoryImpl"
        scope="singleton"
        activation="eager">
        <argument ref="MerlotProcessorDataLector62xBean"/>
    </bean>  
    
    
    <!--Service Bean--> 
    <bean
        id="MerlotLecto620ShippingPackageServiceBean"
        class="org.apache.plc4x.merlot.lector62x.impl.MerlotLecto620ShippingPackageServiceImpl"
        scope="singleton"
        activation="eager">
        <argument ref="MerlotLecto620ShippingPackageRepositoryBean"/>
    </bean>  
    
  
                                     
    <!--Processor Decanter-->           
    <service ref="MerlotProcessorDataLector62xBean" auto-export="interfaces">
        <service-properties>
            <entry key="service.pid" value="org.apache.plc4x.merlot.lector62x.connection.database"/>
            <entry key="event.topics" value="decanter/collect/socket"/>
        </service-properties>
    </service>
    
    <!--Repository--> 
    <service ref="MerlotLecto620ShippingPackageRepositoryBean" auto-export="interfaces"/>
    
    <!--Service--> 
    <service ref="MerlotLecto620ShippingPackageServiceBean" auto-export="interfaces"/>
    
    <!--Servlets-->
    <service interface="javax.servlet.Servlet">
        <service-properties>
            <entry key="alias" value="/v1/jsonrpc/api/guias"/>
            <entry key="servlet-name" value="ResponseServer" />
            <entry key="osgi.http.whiteboard.servlet.asyncSupported" value="true"/>
        </service-properties>
        <bean
            class="org.apache.plc4x.merlot.lector62x.controller.MerlotLecto620ShippingPackageServletConfirmDataImpl">
            <argument ref="MerlotLecto620ShippingPackageServiceBean" />
        </bean>
    </service>
</blueprint>