<blueprint
    xmlns="http://www.osgi.org/xmlns/blueprint/v1.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.osgi.org/xmlns/blueprint/v1.0.0 http://www.osgi.org/xmlns/blueprint/v1.0.0/blueprint.xsd">


    <reference
        id="refEventAdminService"
        interface="org.osgi.service.event.EventAdmin" availability="mandatory" timeout="1200"/>  
    <reference
        id="refDatasourceService"
        interface="javax.sql.DataSource" availability="mandatory" timeout="1200"/>  
    
    <bean
        id="MerlotLogRecordServiceManagedBean"
        class="org.apache.plc4x.merlot.logrecorder.servlets.core.MerlotServiceManagedLogParameters"
        scope="singleton"
        activation="eager"/>


    <service ref="MerlotLogRecordServiceManagedBean" auto-export="interfaces">
        <service-properties>
            <entry key="service.pid" value="org.apache.plc4x.merlot.logrecorder"/>
        </service-properties>
    </service>


    <!--Collector and Processor-->
    <bean
        id="merlotActionBean"
        class="org.apache.plc4x.merlot.logrecorder.core.MerlotLogRecorderActionImpl"
        scope="singleton"
        activation="eager">
        <argument ref="refEventAdminService" />  
    </bean>


    <service
        ref="merlotActionBean"
        interface="org.apache.plc4x.merlot.logrecorder.api.MerlotLogRecorderAction"/>

    <!--JDBC Appender-->
    <bean
        id="merlotLogRecorderJDBCAppenderBean"
        class="org.apache.plc4x.merlot.logrecorder.appender.MerlotLogRecorderJDBCAppender"
        scope="singleton"
        activation="eager">
        <argument ref="blueprintBundleContext" />
    </bean>
    
    <service ref="merlotLogRecorderJDBCAppenderBean" auto-export="interfaces">
        <service-properties>
            <entry key="service.pid" value="org.apache.plc4x.merlot.logrecorder.connection.database"/>
            <entry key="event.topics" value="merlot/olog"/>
        </service-properties>
    </service>

    <!--Servlets-->
    <service interface="javax.servlet.Servlet">
        <service-properties>
            <entry key="alias" value="/Olog" />
            <entry key="servlet-name" value="Handshake" />
            <entry key="osgi.http.whiteboard.servlet.asyncSupported" value="true"/>
        </service-properties>
        <bean
            class="org.apache.plc4x.merlot.logrecorder.servlets.MerlotLogRecorderStart">
        </bean>
    </service>

    <service interface="javax.servlet.Servlet">
        <service-properties>
            <entry key="alias" value="/Olog/levels" />
            <entry key="servlet-name" value="GetLevels" />
            <entry key="osgi.http.whiteboard.servlet.asyncSupported" value="true"/>
        </service-properties>
        <bean  class="org.apache.plc4x.merlot.logrecorder.servlets.MerlotLogRecorderLevel">
            <argument ref="MerlotLogRecordServiceManagedBean" />
        </bean>
    </service>

    <service interface="javax.servlet.Servlet">
        <service-properties>
            <entry key="alias" value="/Olog/tags" />
            <entry key="servlet-name" value="GetTags" />
            <entry key="osgi.http.whiteboard.servlet.asyncSupported" value="true"/>
        </service-properties>
        <bean class="org.apache.plc4x.merlot.logrecorder.servlets.MerlotLogRecorderTag">
            <argument ref="MerlotLogRecordServiceManagedBean" />
        </bean>
    </service>

    <service interface="javax.servlet.Servlet">
        <service-properties>
            <entry key="alias" value="/Olog/logbooks" />
            <entry key="servlet-name" value="GetLogbooks" />
            <entry key="osgi.http.whiteboard.servlet.asyncSupported" value="true"/>
        </service-properties>
        <bean class="org.apache.plc4x.merlot.logrecorder.servlets.MerlotLogRecorderLogbook">
            <argument ref="MerlotLogRecordServiceManagedBean" />
        </bean>
    </service>

    <service interface="javax.servlet.Servlet">
        <service-properties>
            <entry key="alias" value="/Olog/properties" />
            <entry key="servlet-name" value="GetProperties" />
            <entry key="osgi.http.whiteboard.servlet.asyncSupported" value="true"/>
        </service-properties>
        <bean class="org.apache.plc4x.merlot.logrecorder.servlets.MerlotLogRecorderProperty">
            <argument ref="MerlotLogRecordServiceManagedBean" />
        </bean>
    </service>

    <service interface="javax.servlet.Servlet">
        <service-properties>
            <entry key="alias" value="/Olog/templates" />
            <entry key="servlet-name" value="GetTemplates" />
            <entry key="osgi.http.whiteboard.servlet.asyncSupported" value="true"/>
        </service-properties>
        <bean class="org.apache.plc4x.merlot.logrecorder.servlets.MerlotLogRecorderTemplate">
            <argument ref="MerlotLogRecordServiceManagedBean" />
        </bean>
    </service>

    <service interface="javax.servlet.Servlet">
        <service-properties>
            <entry key="alias" value="/Olog/logs/attachments" />
            <entry key="servlet-name" value="Attachments" />
            <entry key="osgi.http.whiteboard.servlet.asyncSupported" value="true"/>

        </service-properties>
        <bean
            class="org.apache.plc4x.merlot.logrecorder.servlets.MerlotLogRecorderLog">
            <argument ref="blueprintBundleContext" />
           
        </bean>
    </service>

    <service interface="javax.servlet.Servlet">
        <service-properties>
            <entry key="alias" value="/Olog/logs/multipart" />
            <entry key="servlet-name" value="AcceptlogMultiPart" />

            <!-- Enable support Multipart -->
            <entry key="osgi.http.whiteboard.servlet.multipart.enabled" value="true"/>

            
            <entry key="osgi.http.whiteboard.servlet.multipart.maxFileSize" value="10485760"/>
            <entry key="osgi.http.whiteboard.servlet.multipart.maxRequestSize" value="20971520"/>
            <entry key="osgi.http.whiteboard.servlet.multipart.fileSizeThreshold" value="1048576"/>
            <entry key="osgi.http.whiteboard.servlet.asyncSupported" value="true"/>
        </service-properties>
        <bean
            class="org.apache.plc4x.merlot.logrecorder.servlets.MerlotLogRecorderLogMultipart">
            <argument ref="merlotActionBean" />
        </bean>
    </service>

    <service interface="javax.servlet.Servlet">
        <service-properties>
            <entry key="alias" value="/Olog/logs/search" />
            <entry key="servlet-name" value="SearchLog" />
            
            <!-- Enable support Multipart -->
            <entry key="osgi.http.whiteboard.servlet.multipart.enabled" value="true"/>
            <entry key="osgi.http.whiteboard.servlet.multipart.maxFileSize" value="10485760"/>
            <entry key="osgi.http.whiteboard.servlet.multipart.maxRequestSize" value="20971520"/>
            <entry key="osgi.http.whiteboard.servlet.multipart.fileSizeThreshold" value="1048576"/>
            <entry key="osgi.http.whiteboard.servlet.asyncSupported" value="true"/>
        </service-properties>
        <bean
            class="org.apache.plc4x.merlot.logrecorder.servlets.MerlotLogRecorderSearch">
            <argument ref="merlotLogRecorderJDBCAppenderBean" />
        </bean>
    </service>
</blueprint>
