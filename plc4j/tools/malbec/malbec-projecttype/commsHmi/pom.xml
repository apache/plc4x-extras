<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.apache.plc4x.malbec.projecttype</groupId>
        <artifactId>projecttype</artifactId>
        <version>1.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>commsHmi</artifactId>
    <packaging>nbm</packaging>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.netbeans.utilities</groupId>
                <artifactId>nbm-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <publicPackages>
                        <publicPackage>org.apache.plc4x.malbec.projecttype.panelcategory.comms.api</publicPackage>
                        <publicPackage>org.apache.plc4x.malbec.projecttype.panelcategory.model</publicPackage>
                        <publicPackage>org.apache.plc4x.malbec.projecttype.panelcategory.comms.plcopen</publicPackage>
                        <publicPackage>org.apache.plc4x.malbec.projecttype.panelcategory.comms.persistence</publicPackage>
                    </publicPackages>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                </configuration>
                <executions>
                    <!--
                      T3.11. Publica tambien el arbol de pruebas como test-jar para que
                      HMIPanelSubprojectCategory pueda reutilizar los dobles en vez de
                      mantener copias. Sin esto, NoopCommunicationStore living en dos
                      paquetes que podian divergir sin que nada lo notara.
                    -->
                    <execution>
                        <id>test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.xmlbeans</groupId>
                <artifactId>xmlbeans</artifactId>
                <version>${xmlbeans.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <schemaDirectory>src/main/schema</schemaDirectory>
                    <repackage>org.apache.plc4x.malbec.comms.plcopen.metadata</repackage>
                    <noUpa>true</noUpa>
                    <noPvr>true</noPvr>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.xmlbeans</groupId>
            <artifactId>xmlbeans</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>