    </properties>

    <!--
      T2.1. Versiones de las dependencias centralizadas en un solo sitio.

      Antes cada modulo repetia la version en cada dependencia, unas veces como
      ${netbeans.version} y otras como RELEASE310 escrito a pelo. Las dos formas
      resolvian al mismo valor, de modo que esto no cambia la resolucion: solo deja
      las declaraciones de los modulos sin <version>.

      No se declara <scope> a proposito. Los modulos declaran estas dependencias
      en scope compile y los tests de JUnit en scope test; fijarlos aqui cambiaria
      el empaquetado del NBM, asi que el scope se sigue declarando en cada modulo.

      Las API de NetBeans las aporta la plataforma, asi que no se empaquetan en el
      jar ni en el NBM del modulo aunque esten en scope compile.
    -->
    <dependencyManagement>
        <dependencies>
            <!-- org.netbeans.api:* -->
