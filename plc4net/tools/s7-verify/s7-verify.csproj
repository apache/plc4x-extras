<Project Sdk="Microsoft.NET.Sdk" InitialTargets="ValidatePlc4xSourceRoot">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputType>Exe</OutputType>
    <AssemblyName>s7-verify</AssemblyName>
    <Title>PLC4Net: S7 Verification</Title>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>s7-verify</ToolCommandName>
    <PackageId>plc4net-s7-verify</PackageId>
    <Description>Local S7 verification tool for the plc4net S7 driver.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Plc4xSourceRoot Condition="'$(Plc4xSourceRoot)' == ''">$(PLC4X_SOURCE_ROOT)</Plc4xSourceRoot>
  </PropertyGroup>

  <Target Name="ValidatePlc4xSourceRoot">
    <Error Condition="'$(Plc4xSourceRoot)' == '' Or !Exists('$(Plc4xSourceRoot)/plc4net/drivers/s7/s7.csproj')"
           Text="Set PLC4X_SOURCE_ROOT (or -p:Plc4xSourceRoot) to a PLC4X source checkout; see README.md." />
  </Target>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
    <ProjectReference Include="$(Plc4xSourceRoot)/plc4net/api/api.csproj" />
    <ProjectReference Include="$(Plc4xSourceRoot)/plc4net/drivers/s7/s7.csproj" />
    <ProjectReference Include="$(Plc4xSourceRoot)/plc4net/transports/cotp/cotp.csproj" />
    <ProjectReference Include="$(Plc4xSourceRoot)/plc4net/transports/tcp/tcp.csproj" />
  </ItemGroup>
</Project>
